 "strings": {
  "locale": "zh-Hans",
  "strings": {
   "scene.zhanguo.jingke.title": "易水寒",
   "scene.zhanguo.jingke.subtitle": "荆轲刺秦王",
   "scene.zhanguo.jingke.when": "秦王政二十年",
   "vo.01": "秦王政二十年。秦军已破赵，兵锋直指燕境。",
   "vo.02": "燕太子丹曾为质于秦，归国之后，日夜所思，唯有报秦。",
   "vo.03": "处士田光荐卫人荆轲。为求一见秦王，荆轲携秦亡将樊於期之首，与燕国督亢之图。",
   "scene.zhanguo.jingke.quote.yishui": "风萧萧兮易水寒，壮士一去兮不复还。",
   "vo.04": "咸阳宫上，副使秦舞阳面色骤变。荆轲回顾一笑，独自捧图上前。",
   "vo.05": "图卷徐徐展开，展到尽头——",
   "scene.zhanguo.jingke.fork.prompt": "此刻落笔，循哪一卷而书？",
   "scene.zhanguo.jingke.pick.canon": "正史 · 《史记》所载",
   "scene.zhanguo.jingke.pick.legend": "野史 · 琴声三问",
   "scene.zhanguo.jingke.pick.whatif": "推演 · 若舞阳不惧（未开放）",
   "scene.zhanguo.jingke.legend.disclaimer": "以下为野史所载，出自《燕丹子》一系的传说，《史记》不载。",
   "scene.zhanguo.jingke.end.canon": "荆轲倚柱而笑，事终不成。次年，秦军破蓟。",
   "scene.zhanguo.jingke.end.legend": "一曲未终，秦王已越屏而去。荆轲之结局，与正史同。",
   "scene.zhanguo.jingke.end.whatif": "异闻 · 未开放",
   "anchor.dan-return": "太子丹自秦亡归",
   "anchor.yan-ji-falls": "秦破蓟城"
  },
  "_note": "以上文字为本项目原创（史记原句“风萧萧兮易水寒……”为公有领域古籍引文，已在 caption 的 source 字段标明出处）。"
 }
